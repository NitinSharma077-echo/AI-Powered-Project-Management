# OpenAI credentials - required for meeting analysis and plan generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=180

# Shared secret expected in the X-AI-Service-Token header.
# Must be IDENTICAL to AI_SERVICE_TOKEN in apps/apis/.env
AI_SERVICE_TOKEN=
