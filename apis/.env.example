# Express API configuration
PORT=5000
NODE_ENV=development

# Origin allowed by CORS - must match the frontend URL exactly
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local mongod or an Atlas SRV URI)
MONGODB_URI=

# Secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the FastAPI AI service is reachable
AI_SERVICE_URL=http://localhost:8000

# Shared secret sent as the X-AI-Service-Token header.
# Must be IDENTICAL to AI_SERVICE_TOKEN in apps/ai/.env
AI_SERVICE_TOKEN=
